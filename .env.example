# Blockchain
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
WEB3_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
BACKEND_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
CONTRACT_ADDRESS=
CHAIN_ID=11155111

# FastAPI
ENV=development  # đổi thành production khi deploy
# Tạo secret riêng: python -c "import secrets; print(secrets.token_urlsafe(32))"
DATABASE_URL=sqlite:///./mediaguard.db
JWT_SECRET=REPLACE_ME_GENERATE_A_RANDOM_SECRET
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
VERIFY_RATE_LIMIT=30
AUTH_RATE_LIMIT=10
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional Gemini metadata generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
