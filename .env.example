# FastAPI - production bắt buộc đổi JWT_SECRET
DATABASE_URL=sqlite:///./mediaguard.db
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional Gemini metadata generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
